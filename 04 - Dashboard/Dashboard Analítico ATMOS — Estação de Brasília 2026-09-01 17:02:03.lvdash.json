{
  "datasets": [
    {
      "name": "atmos_clima_mensal",
      "displayName": "ATMOS Clima Mensal",
      "config": {
        "source": "atmos.gold.perfil_sazonal_mensal",
        "measures": [
          {
            "name": "temperatura_media_c",
            "expr": "ROUND(AVG(COALESCE(temperatura_media_c, 0)), 2)",
            "displayName": "Temperatura Média (°C)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "temperatura_maxima_media_c",
            "expr": "ROUND(AVG(COALESCE(temperatura_maxima_media_c, 0)), 2)",
            "displayName": "Temperatura Máxima Média (°C)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "temperatura_minima_media_c",
            "expr": "ROUND(AVG(COALESCE(temperatura_minima_media_c, 0)), 2)",
            "displayName": "Temperatura Mínima Média (°C)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "temperatura_maxima_abs_c",
            "expr": "ROUND(MAX(COALESCE(temperatura_maxima_abs_c, 0)), 2)",
            "displayName": "Temperatura Máxima Absoluta (°C)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "temperatura_minima_abs_c",
            "expr": "ROUND(MIN(COALESCE(temperatura_minima_abs_c, 0)), 2)",
            "displayName": "Temperatura Mínima Absoluta (°C)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "precipitacao_total_mm",
            "expr": "ROUND(SUM(COALESCE(precipitacao_total_mm, 0)), 2)",
            "displayName": "Precipitação Total (mm)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "umidade_media_pct",
            "expr": "ROUND(AVG(COALESCE(umidade_media_pct, 0)), 2)",
            "displayName": "Umidade Média (%)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "amplitude_termica_media_c",
            "expr": "ROUND(AVG(COALESCE(amplitude_termica_media_c, 0)), 2)",
            "displayName": "Amplitude Térmica Média (°C)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "temperatura_media_2026_c",
            "expr": "ROUND(AVG(CASE WHEN ano = 2026 THEN COALESCE(temperatura_media_c, 0) END), 2)",
            "displayName": "Temperatura Média 2026 (°C)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "precipitacao_total_2026_mm",
            "expr": "ROUND(SUM(CASE WHEN ano = 2026 THEN COALESCE(precipitacao_total_mm, 0) END), 2)",
            "displayName": "Precipitação 2026 (mm)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ],
        "filter": "cidade IN ('Brasília', 'Brasilia', 'BRASILIA')",
        "version": "1.1",
        "comment": "Métricas climáticas mensais derivadas da camada gold do projeto ATMOS para a estação de Brasília",
        "dimensions": [
          {
            "name": "id_estacao",
            "expr": "id_estacao",
            "displayName": "ID Estação"
          },
          {
            "name": "cidade",
            "expr": "cidade",
            "displayName": "Cidade"
          },
          {
            "name": "ano",
            "expr": "ano",
            "displayName": "Ano"
          },
          {
            "name": "mes",
            "expr": "mes",
            "displayName": "Mês"
          },
          {
            "name": "mes_nome",
            "expr": "CASE mes\n  WHEN 1 THEN '01 Jan'\n  WHEN 2 THEN '02 Fev'\n  WHEN 3 THEN '03 Mar'\n  WHEN 4 THEN '04 Abr'\n  WHEN 5 THEN '05 Mai'\n  WHEN 6 THEN '06 Jun'\n  WHEN 7 THEN '07 Jul'\n  WHEN 8 THEN '08 Ago'\n  WHEN 9 THEN '09 Set'\n  WHEN 10 THEN '10 Out'\n  WHEN 11 THEN '11 Nov'\n  WHEN 12 THEN '12 Dez'\nEND",
            "displayName": "Mês"
          },
          {
            "name": "periodo_mensal",
            "expr": "MAKE_DATE(ano, mes, 1)",
            "displayName": "Período Mensal",
            "format": {
              "type": "date",
              "dateFormat": "locale_short_month"
            }
          },
          {
            "name": "trimestre",
            "expr": "QUARTER(MAKE_DATE(ano, mes, 1))",
            "displayName": "Trimestre"
          },
          {
            "name": "estacao_ano",
            "expr": "CASE\n  WHEN mes IN (12, 1, 2) THEN 'Verão'\n  WHEN mes IN (3, 4, 5) THEN 'Outono'\n  WHEN mes IN (6, 7, 8) THEN 'Inverno'\n  ELSE 'Primavera'\nEND",
            "displayName": "Estação do Ano"
          }
        ]
      }
    },
    {
      "name": "atmos_kpis_brasilia",
      "displayName": "ATMOS KPIs Brasília",
      "queryLines": [
        "WITH base AS (\n",
        "  SELECT\n",
        "    MAKE_DATE(ano, mes, 1) AS data_ref,\n",
        "    COALESCE(temperatura_media_c, 0) AS temperatura_media_c,\n",
        "    COALESCE(temperatura_maxima_abs_c, 0) AS temperatura_maxima_abs_c,\n",
        "    COALESCE(temperatura_minima_abs_c, 0) AS temperatura_minima_abs_c,\n",
        "    COALESCE(precipitacao_total_mm, 0) AS precipitacao_total_mm,\n",
        "    COALESCE(umidade_media_pct, 0) AS umidade_media_pct,\n",
        "    ano\n",
        "  FROM\n",
        "    atmos.gold.perfil_sazonal_mensal\n",
        "  WHERE\n",
        "    cidade IN ('Brasília', 'Brasilia', 'BRASILIA')\n",
        ")\n",
        "SELECT\n",
        "  ROUND(\n",
        "    AVG(\n",
        "      CASE\n",
        "        WHEN ano = 2026 THEN temperatura_media_c\n",
        "      END\n",
        "    ),\n",
        "    2\n",
        "  ) AS temperatura_media_2026_c,\n",
        "  MAX(\n",
        "    CASE\n",
        "      WHEN ano = 2026 THEN data_ref\n",
        "    END\n",
        "  ) AS data_temp_media_2026,\n",
        "  ROUND(MAX(temperatura_maxima_abs_c), 2) AS temperatura_maxima_abs_c,\n",
        "  MAX_BY(data_ref, temperatura_maxima_abs_c) AS data_temp_max_abs,\n",
        "  ROUND(MIN(temperatura_minima_abs_c), 2) AS temperatura_minima_abs_c,\n",
        "  MIN_BY(data_ref, temperatura_minima_abs_c) AS data_temp_min_abs,\n",
        "  ROUND(\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN ano = 2026 THEN precipitacao_total_mm\n",
        "      END\n",
        "    ),\n",
        "    2\n",
        "  ) AS precipitacao_total_2026_mm,\n",
        "  MAX(\n",
        "    CASE\n",
        "      WHEN ano = 2026 THEN data_ref\n",
        "    END\n",
        "  ) AS data_precip_2026,\n",
        "  ROUND(AVG(umidade_media_pct), 2) AS umidade_media_pct,\n",
        "  MAX(data_ref) AS data_umidade_media,\n",
        "  MIN(data_ref) AS periodo_inicio,\n",
        "  MAX(data_ref) AS periodo_fim\n",
        "FROM\n",
        "  base"
      ]
    }
  ],
